# The homepage, demo, and health route require no environment variables.
# Set these for organiser accounts and sessions.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
MONGODB_URI=
# Generate a private value with node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Lifetime of newly created sessions in whole days, from 1 to 400.
SESSION_TTL_DAYS=7
# Wedding member invitation emails use a verified Resend sender and NEXT_PUBLIC_APP_URL.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Private Cloudflare R2 bucket for organiser photos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Generate a separate 64-character hex key for stable guest gallery links.
GALLERY_TOKEN_KEY=
