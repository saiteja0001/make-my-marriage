# The homepage, demo, and health route require no environment variables.
# Set these for organiser accounts and sessions.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
MONGODB_URI=
# Generate a private value with node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Wedding member invitation emails use a verified Resend sender and NEXT_PUBLIC_APP_URL.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
